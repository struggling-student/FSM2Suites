*** Settings ***
Library         ../ExampleLibrary.py

*** Machine ***

${TEMPERATURE}    any of    15    20    25    30    35    40
${HUMIDITY}       any of    30    40    50    60    70    80    90
${PRESSURE}       any of    990    1000    1010    1020    1030
${STATUS}         any of    normal    warning    critical    emergency
${SENSOR_ID}      any of    temp01    temp02    humid01    humid02    press01
${MODE}           any of    auto    manual    maintenance    test
${ALERT_LEVEL}    any of    0    1    2    3    4    5
${RESPONSE_TIME}  any of    100    200    500    1000    2000
${SYSTEM_LOAD}    any of    low    medium    high    critical

# 1. IMPLICATION RULES (==>)
${TEMPERATURE} >= 35  ==>  ${STATUS} != normal
${SYSTEM_LOAD} == critical  ==>  ${RESPONSE_TIME} >= 1000

# 2. EQUIVALENCE RULES (<==>)
${STATUS} == normal  <==>  ${ALERT_LEVEL} <= 2
${MODE} == maintenance  <==>  ${ALERT_LEVEL} <= 1

# 3. EQUALITY (==) and INEQUALITY (!=)
${MODE} == test  ==>  ${STATUS} != emergency
${SENSOR_ID} != press01  ==>  ${PRESSURE} >= 1000

# 4. GREATER/LESS THAN OR EQUAL (>=, <=)
${HUMIDITY} >= 90  ==>  ${ALERT_LEVEL} >= 3
${TEMPERATURE} <= 20  ==>  ${STATUS} == normal

# 5. REGEX MATCHING (~) and NEGATED REGEX (!~)
${SENSOR_ID} ~ temp.*  ==>  ${TEMPERATURE} >= 20
${SENSOR_ID} !~ press.*  ==>  ${PRESSURE} <= 1020

# 6. COMPLEX AND CONDITIONS
(${TEMPERATURE} >= 40  and  ${HUMIDITY} >= 90)  ==>  ${STATUS} == critical
(${MODE} == maintenance  and  ${STATUS} == normal)  ==>  ${ALERT_LEVEL} <= 1

# 7. COMPLEX OR CONDITIONS  
(${TEMPERATURE} >= 40  or  ${HUMIDITY} >= 90  or  ${PRESSURE} <= 990)  ==>  ${ALERT_LEVEL} >= 4
(${MODE} == manual  or  ${MODE} == test)  ==>  ${RESPONSE_TIME} <= 1000

# 8. MIXED AND/OR WITH NESTED CONDITIONS
((${TEMPERATURE} >= 35  and  ${HUMIDITY} >= 80)  or  (${PRESSURE} <= 990  and  ${SYSTEM_LOAD} == critical))  ==>  ${RESPONSE_TIME} >= 1000

# 9. COMPLEX CONDITIONS ON RIGHT SIDE
${MODE} == test  ==>  (${ALERT_LEVEL} <= 3  and  ${STATUS} != emergency)
${STATUS} == critical  ==>  (${ALERT_LEVEL} >= 4  or  ${RESPONSE_TIME} >= 1000)

Start
  [Actions]
    initialize system   ==>  Initialization

Normal
  [Actions]
    continue monitoring  ==>  Monitoring
    schedule maintenance  ==>  Monitoring      when  ${MODE} == maintenance
    run diagnostics      ==>  Monitoring      when  ${ALERT_LEVEL} == 0

Warning
  [Actions]
    review warning      ==>  Monitoring      when  ${ALERT_LEVEL} <= 2
    escalate warning    ==>  Alert           when  ${ALERT_LEVEL} > 2
    investigate issue   ==>  Monitoring      when  ${SENSOR_ID} ~ temp.* and ${TEMPERATURE} > 30

Alert
  [Actions]
    acknowledge alert   ==>  Monitoring      when  ${ALERT_LEVEL} <= 3
    escalate alert      ==>  Critical        when  ${ALERT_LEVEL} > 3
    emergency protocol  ==>  Monitoring      when  ${STATUS} == emergency

Critical
  [Actions]
    emergency shutdown  ==>  Shutdown        when  ${SYSTEM_LOAD} == critical
    manual override     ==>  Monitoring      when  ${MODE} == manual
    crisis management   ==>  Monitoring      when  ${ALERT_LEVEL} >= 4

Shutdown
  [Actions]
    maintenance mode    ==>  Monitoring      when  ${MODE} == maintenance

Initialization
  [Actions]
    check sensors       ==>  Monitoring      when  ${STATUS} == normal
    calibrate system    ==>  Monitoring      when  ${MODE} == maintenance
    start diagnostics   ==>  Monitoring      when  ${MODE} == test
    emergency mode      ==>  Monitoring      when  ${STATUS} == emergency
    crisis response     ==>  Monitoring      when  ${STATUS} == critical
    warning response    ==>  Monitoring      when  ${STATUS} == warning

Monitoring
  [Actions]
    # Test equality conditions (==)
    read temperature    ==>  Normal          when  ${TEMPERATURE} == 25 and ${STATUS} == normal
    
    # Test inequality conditions (!=) 
    read humidity       ==>  Alert           when  ${HUMIDITY} != 50 and ${SENSOR_ID} != temp01
    
    # Test greater than conditions (>)
    monitor pressure    ==>  Alert           when  ${PRESSURE} > 1020
    check load          ==>  Alert           when  ${ALERT_LEVEL} > 3
    
    # Test greater than or equal conditions (>=)
    read temperature    ==>  Alert           when  ${TEMPERATURE} >= 35
    monitor response    ==>  Warning         when  ${RESPONSE_TIME} >= 1000
    
    # Test less than conditions (<)
    check pressure      ==>  Alert           when  ${PRESSURE} < 1000
    monitor alerts      ==>  Normal          when  ${ALERT_LEVEL} < 2
    
    # Test less than or equal conditions (<=)
    read temperature    ==>  Normal          when  ${TEMPERATURE} <= 20
    check humidity      ==>  Normal          when  ${HUMIDITY} <= 40
    
    # Test regex conditions (~)
    sensor check        ==>  Normal          when  ${SENSOR_ID} ~ temp.*
    sensor check        ==>  Normal          when  ${SENSOR_ID} ~ humid.*
    
    # Test negated regex conditions (!~)
    validate sensor     ==>  Alert           when  ${SENSOR_ID} !~ press.*
    
    # Test complex AND conditions
    full check          ==>  Normal          when  ${TEMPERATURE} >= 20 and ${TEMPERATURE} <= 30 and ${HUMIDITY} >= 40 and ${HUMIDITY} <= 70
    system validation   ==>  Normal          when  ${PRESSURE} >= 1000 and ${PRESSURE} <= 1020 and ${STATUS} == normal and ${MODE} == auto
    
    # Test complex OR conditions  
    alert check         ==>  Alert           when  ${TEMPERATURE} > 35 or ${TEMPERATURE} < 15 or ${HUMIDITY} > 80 or ${HUMIDITY} < 30
    mode switch         ==>  Normal          when  ${MODE} == manual or ${MODE} == maintenance or ${SYSTEM_LOAD} == critical
    
    # Test NOT conditions (implemented via negation)
    safety check        ==>  Normal          when  ${STATUS} != emergency and ${ALERT_LEVEL} <= 2
    
    # Complex nested conditions
    advanced check      ==>  Warning         when  (${TEMPERATURE} > 25 and ${HUMIDITY} < 60) or (${PRESSURE} > 1015 and ${MODE} == auto)

