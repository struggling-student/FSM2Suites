*** Settings ***
Library    ExampleLibrary.py

*** Machine ***
${CONDITION_A}    any of    yes     no
${CONDITION_B}    any of    yes     no  
${RESULT}         any of    success  failure

# Demonstrate logical operators and rules
${CONDITION_A} == yes   ==>  ${RESULT} == success
${CONDITION_A} == no    ==>  ${RESULT} == failure
${CONDITION_A} == yes  <==>  ${CONDITION_B} == yes

Start
    Log    Testing logical combinations: A=${CONDITION_A}, B=${CONDITION_B}
  [Actions]
    test_condition   ==>    TestA           when    ${CONDITION_A} == yes
    test_condition   ==>    TestB           when    ${CONDITION_A} == no

TestA
    Log    Testing condition A=yes: ${CONDITION_A}
  [Actions]
    verify_success   ==>    Success         when    ${RESULT} == success
    verify_failure   ==>    Failure         otherwise

TestB
    Log    Testing condition A=no: ${CONDITION_A}
  [Actions]
    verify_failure   ==>    Failure         when    ${RESULT} == failure
    verify_success   ==>    Success         otherwise

Success
    Log    Test successful with result: ${RESULT}
  [Actions]
    continue_testing ==>   Start

Failure  
    Log    Test failed with result: ${RESULT}
  [Actions]
    retry_testing    ==>   Start

*** Keywords ***
Test Condition
    Log    Testing condition logic

Verify Success
    Log    Verifying success condition

Verify Failure
    Log    Verifying failure condition

Continue Testing
    Log    Continuing tests

Retry Testing
    Log    Retrying tests
