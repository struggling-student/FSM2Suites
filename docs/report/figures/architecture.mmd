flowchart TD
    %% Input Layer
    MF[".machine File<br/>State Machine Definition"]
    
    %% Parsing Layer
    P["Parser<br/>(parsing.py)"]
    M["State Machine Model<br/>(model.py)"]
    
    %% Generation Layer
    G["Test Generator<br/>(generator.py)"]
    
    %% Strategy Layer
    subgraph Strategies["Test Generation Strategies"]
        DFS["Depth First Search<br/>(strategies.py)"]
        AP["All Pairs<br/>(allpairsstrategy.py)"]
        R["Random<br/>(strategies.py)"]
    end
    
    %% Output Layer
    RF[".robot Files<br/>Robot Framework Tests"]
    
