# Database
DATABASE_URL=postgresql://username:password@localhost:5432/travelplan_db
DATABASE_URL_TEST=postgresql://username:password@localhost:5432/travelplan_test_db

# Security
SECRET_KEY=your-secret-key-here-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# API
API_V1_STR=/api/v1
PROJECT_NAME=TravelPlan API

# Environment
ENVIRONMENT=development
DEBUG=True

# CORS
BACKEND_CORS_ORIGINS=["http://localhost:3000", "http://localhost:3001"]
